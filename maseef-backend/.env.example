# Copy these lines into your real .env (which is git-ignored) and fill them in.
# Never commit real values.

# --- Password reset -------------------------------------------------------
# Signs the reset links. 32+ random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it invalidates every reset link that is still out there.
PASSWORD_RESET_SECRET=

# Where the Flutter web app is served. The email link is
#   <APP_BASE_URL>/#/reset-password?token=...
# e.g. http://localhost:8080 while testing, https://your-domain.com live.
APP_BASE_URL=

# How long a reset link works, in minutes (1-1440). Optional, default 60.
# PASSWORD_RESET_TTL_MINUTES=60

# --- Outgoing email (SMTP) -----------------------------------------------
# Any SMTP provider works (Gmail, Outlook, Brevo, Mailgun, SendGrid, ...).
SMTP_HOST=
# 587 = STARTTLS (default). For 465 also set SMTP_SECURE=true.
SMTP_PORT=587
# SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# The sender shown to the user. Must be allowed by your SMTP provider.
MAIL_FROM="MASEEF <no-reply@your-domain.com>"
